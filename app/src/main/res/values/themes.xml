    <!-- Sin esto, el ítem seleccionado del bottom nav muestra un "pill" de fondo
         colorSecondaryContainer (no definido por paleta, sale con un color genérico).
         No existe un atributo XML directo para ese color en el propio BottomNavigationView;
         se anula acá vía el estilo del indicador. -->
    <style name="Widget.MiClima.BottomNavigationView.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

</resources>
