<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 4 paletas fijas sobre Material3 DayNight (sin ActionBar; usamos MaterialToolbar propia).
         Cuando la paleta elegida es "Automático", MiClimaApp aplica Material You (Android 12+)
         por encima de Theme.MiClima.Green como base. -->

    <style name="Theme.MiClima.Green" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_token_primary</item>
        <item name="colorOnPrimary">@color/green_token_on_primary</item>
        <item name="colorPrimaryContainer">@color/green_token_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/green_token_on_primary_container</item>
        <item name="colorSecondary">@color/green_token_primary</item>
        <item name="colorSecondaryContainer">@color/green_token_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/green_token_on_primary_container</item>
        <item name="colorSurfaceContainer">@color/green_token_surface_alt</item>
        <item name="android:colorBackground">@color/green_token_bg</item>
        <item name="colorSurfaceContainerLowest">@color/green_token_bg</item>
        <item name="colorSurface">@color/green_token_surface</item>
        <item name="colorSurfaceContainerHigh">@color/green_token_surface_alt</item>
        <item name="colorOnSurface">@color/green_token_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/green_token_on_surface_variant</item>
        <item name="colorOutlineVariant">@color/green_token_outline</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_danger</item>
    </style>

